async def main() -> None:
    logger.info("World Eldoria is starting...")

    try:
        await setup_bot_commands()
        logger.info("Bot commands registered.")

        boss_task = asyncio.create_task(boss_scheduler(), name="world-eldoria-group-boss-scheduler")
        fan_art_task = asyncio.create_task(fan_art_scheduler(), name="world-eldoria-fan-art-scheduler")
        pet_task = asyncio.create_task(pet_training_scheduler(bot), name="world-eldoria-pet-training-scheduler")
        death_task = asyncio.create_task(death_revival_scheduler(bot), name="world-eldoria-death-revival-scheduler")
        dungeon_task = asyncio.create_task(dungeon_scheduler(bot), name="world-eldoria-dungeon-scheduler")
        guild_sale_task = asyncio.create_task(guild_sale_payout_scheduler(), name="guild-sale-payout")
        try:
            await dp.start_polling(bot)
        finally:
            for task in (boss_task, fan_art_task, pet_task, death_task, dungeon_task, guild_sale_task):
                task.cancel()
            for task in (boss_task, fan_art_task, pet_task, death_task, dungeon_task, guild_sale_task):
                try:
                    await task
                except asyncio.CancelledError:
                    pass

    except asyncio.CancelledError:
        logger.info("World Eldoria polling was cancelled.")
        raise

    except Exception:
        logger.exception(
            "World Eldoria stopped because of an unexpected error."
        )
        raise

    finally:
        logger.info("Closing Telegram bot session...")

        if not bot.session.closed:
            await bot.session.close()

        logger.info("World Eldoria stopped.")


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("World Eldoria stopped by keyboard interrupt.")